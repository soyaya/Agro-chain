# Server-side (runtime): where the backend API lives
BASE_BACKEND_URL=http://localhost:5000
# Client-side (BAKED IN AT BUILD TIME — pass as a Docker build arg)
NEXT_PUBLIC_BASE_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_IPSTACK_API_KEY=
# REQUIRED in production: signs session tokens (long random string)
AUTH_SESSION_SECRET=
