# Server-side only (used in Next.js API proxy routes and server components)
BASE_BACKEND_URL=http://localhost:5002

# Client-side (used in browser fetch calls — must match BASE_BACKEND_URL)
NEXT_PUBLIC_BASE_BACKEND_URL=http://localhost:5002

# === Cloudinary (document uploads for cluster farmer applications)
# 1. Create a free account at https://cloudinary.com
# 2. In your Cloudinary dashboard → Settings → Upload → Upload Presets
# 3. Create a new preset, set Signing Mode to "Unsigned", note the preset name
# 4. Your cloud name is shown on the dashboard home page
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name_here
